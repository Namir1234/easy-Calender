# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird nicht ins Git-Repository aufgenommen.
#
# Variablen mit dem Präfix MAIN_VITE_ sind nur im Main-Prozess sichtbar,
# nie in der Oberfläche.

# Supabase: Project Settings → API
# Nur den Publishable Key (früher «anon key») verwenden, NIE den Secret Key.
MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_KEY=

# Google: OAuth-Client vom Typ «Desktop app» (Google Cloud Console → Anmeldedaten)
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
